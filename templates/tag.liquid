{% assign empty_message = 'templates.search.no_results' | t: '没有找到相关结果' %}
{% assign tag_pages = tag.pages %}
{% assign tag_pages_size = tag_pages | size %}

<div class="relative min-h-[60vh] bg-base-100 dark:bg-base-100">
  <div class="mx-auto max-w-7xl bg-base-100 px-4 pb-16 pt-8 md:pt-12 dark:bg-base-100" data-controller="link-target">
    <main class="min-w-0 bg-base-100 dark:bg-base-100">
      <div class="flex items-center justify-between gap-4">
        <a class="mr-auto flex" href="javascript: history.back();">
          <button type="button" class="btn btn-sm rounded-full">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" aria-hidden="true">
              <path fill="currentColor"
                d="M16.707 19.293 9.414 12l7.293-7.293-1.414-1.414L6.586 12l8.707 8.707 1.414-1.414z"></path>
            </svg>
            <span class="text-xs font-medium md:text-sm">{{ 'generic.back' | t }}</span>
          </button>
        </a>

        <div class="max-w-xs min-w-[12rem]">
          {% render 'search_trigger' %}
        </div>
      </div>

      <div class="my-4 md:my-8">
        <nav
          class="mx-auto flex max-w-3xl flex-wrap justify-center gap-3"
          aria-label="{{ 'layout.theme.search_tags_label' | t: '热门标签' }}"
        >
          {% for cloud_tag in site.tags %}
            {% if cloud_tag.path == tag.path %}
              <span
                class="rounded-full border border-primary bg-primary px-3 py-2 text-sm text-primary-content"
                aria-current="page"
              >
                {{ cloud_tag.name }}
              </span>
            {% else %}
              <a
                href="{{ cloud_tag.path }}"
                class="rounded-full border border-base-300 bg-base-100 px-3 py-2 text-sm text-base-content/70 transition hover:border-primary hover:bg-primary hover:text-primary-content"
              >
                {{ cloud_tag.name }}
              </a>
            {% endif %}
          {% endfor %}
        </nav>
      </div>

      <header class="pt-2">
        <h1 class="text-2xl font-semibold tracking-tight text-primary md:text-3xl lg:text-4xl">
          # {{ tag.name }}
        </h1>
      </header>

      <section class="mt-8">
        {% if tag_pages_size > 0 %}
          {% paginate_tag tag.pages, as: 'items', per: 20 %}
            {% render 'support_search_list', items: items %}
            {% render 'support_paginate', paginate: paginate %}
          {% endpaginate_tag %}
        {% else %}
          <div class="py-8">
            {% render 'empty', message: empty_message %}
          </div>
        {% endif %}
      </section>
    </main>
  </div>
</div>
