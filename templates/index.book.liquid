{% # Book-style table of contents home page %}
{% assign toc_title = page.settings.toc_title | presence | default: 'templates.index_book.title' | t %}
{% assign toc_max_depth = page.settings.toc_max_depth | default: 10 %}
{% assign show_chapter_prefix = page.settings.show_chapter_prefix != false %}
{% assign show_page_numbers = page.settings.show_page_numbers != false %}
{% assign chapter_prefix = page.settings.chapter_prefix | presence | default: 'templates.index_book.chapter_prefix' | t %}
{% assign root_nav_count = page.children_in_nav_menu | size %}

<main class="bg-base-100 px-4 py-10 md:py-14">
  <div class="mx-auto max-w-3xl font-serif text-base-content">
    <header class="mb-8 text-center">
      <h1 class="text-3xl font-bold tracking-tight md:text-4xl">{{ toc_title }}</h1>
      <div class="mx-auto mt-6 h-px w-full max-w-md bg-base-content/80" aria-hidden="true"></div>
    </header>

    {% if root_nav_count > 0 %}
      <nav class="book-toc-root" aria-label="{{ toc_title }}">
        <ul class="book-toc-list list-none m-0 p-0">
          {% render 'book_toc_pages',
            parent_page: page,
            current_depth: 1,
            max_depth: toc_max_depth,
            show_chapter_prefix: show_chapter_prefix,
            show_page_numbers: show_page_numbers,
            chapter_prefix: chapter_prefix
          %}
        </ul>
      </nav>
    {% else %}
      <p class="text-center text-sm text-base-content/60">{{ 'templates.index_book.empty' | t }}</p>
    {% endif %}
  </div>
</main>

{% schema %}
{
  "name": "Book",
  "description": "Book home",
  "thumb_url": "images/theme/${lang}/index.book.png",
  "preview_image_urls": [
    "images/theme/${lang}/index.book.png"
  ],
  "sub_page_templates": ["page"],
  "settings": [
    {
      "id": "toc_title",
      "type": "text",
      "label": "t:schema.templates.index.book.settings.toc_title.label",
      "default": "Contents"
    },
    {
      "id": "toc_max_depth",
      "type": "number",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 10,
      "label": "t:schema.templates.index.book.settings.toc_max_depth.label",
      "info": "t:schema.templates.index.book.settings.toc_max_depth.info"
    },
    {
      "id": "show_chapter_prefix",
      "type": "checkbox",
      "label": "t:schema.templates.index.book.settings.show_chapter_prefix.label",
      "default": true
    },
    {
      "id": "chapter_prefix",
      "type": "text",
      "label": "t:schema.templates.index.book.settings.chapter_prefix.label",
      "default": "Section"
    },
    {
      "id": "show_page_numbers",
      "type": "checkbox",
      "label": "t:schema.templates.index.book.settings.show_page_numbers.label",
      "info": "t:schema.templates.index.book.settings.show_page_numbers.info",
      "default": true
    }
  ]
}
{% endschema %}
