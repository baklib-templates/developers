{% layout 'page_layout' %}
{% assign sub_pages = page.children_in_list %}
{% assign sub_pages_size = sub_pages | size %}

{% comment %} 页面内容部分 {% endcomment %}
<turbo-frame id="main-content" class='w-full flex-1' x-init="
               $el.addEventListener('turbo:before-fetch-request', () => {
                 $el.scrollTop = 0
                 window.scrollTo({ top: 0, behavior: 'instant' })
               })
             "
>
  <div
    data-controller="toc"
    data-toc-header-selector-value=".js--header"
    data-toc-offset-value="10"
    data-toc-clipboard-success-value="{{ 'templates.page.copy_success' | t }}"
    class='w-full group'
  >
    <div class='w-full grid lg:grid-cols-[1fr] gap-6 group-[.has-toc]:lg:grid-cols-[1fr_240px]'>
      <div class="flex flex-col px-4 lg:px-10 group-[.has-toc]:md:pr-0 py-6 overflow-x-hidden">
        <div class="pt-0 pb-6">
          {% render 'breadcrumb', breadcrumb: page.breadcrumb, page: page %}
        </div>
        {% render 'page', page: page %}
      </div>

      <div class="print:hidden hidden lg:block">
        <div class="sticky top-[5.5rem] h-[calc(100vh-8rem)] max-w-full w-full overflow-auto border-l border-base-200" data-toc-target="menu">
          <div class="menu w-full">
            <div data-toc-target="links"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</turbo-frame>


{% schema %}
  {
    "name": "Page Detail",
    "description": "The content page template",
    "thumb_url": "images/theme/${lang}/page.png",
    "preview_image_urls": [
      "images/theme/${lang}/page.png"
    ],
    "sub_page_templates": ["page"],
    "settings": [
      {
        "id": "tags",
        "type": "tag_picker",
        "multiple": true,
        "label": "t:schema.templates.page.settings.tags.label"
      },
      {
        "id": "nav_lucide_icon",
        "type": "select",
        "label": "t:schema.templates.page.settings.nav_lucide_icon.label",
        "info": "t:schema.templates.page.settings.nav_lucide_icon.info",
        "default": "folder",
        "choices_from": "$site.lucide_icons"
      },
      {
        "id": "description",
        "type": "textarea",
        "label": "t:schema.templates.page.settings.description.label",
        "info": "t:schema.templates.page.settings.description.info"
      },
      {
        "id": "title",
        "type": "text",
        "readonly": true,
        "label": "t:schema.templates.page.settings.title.label",
        "info": "t:schema.templates.page.settings.title.info"
      },
      {
        "id": "content",
        "type": "richtext",
        "label": "t:schema.templates.page.settings.content.label",
        "readonly": true,
        "info": "t:schema.templates.page.settings.content.info"
      }
    ]
  }
{% endschema %}
