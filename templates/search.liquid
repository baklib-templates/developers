{% assign search_placeholder = 'templates.search.placeholder' | t: '搜索指南、API 与集成文档…' %}
{% assign empty_message = 'templates.search.no_results' | t: '没有找到相关结果' %}
{% assign hot_tags = site.settings.hot_tags | newline_to_br | split: '<br />' %}
{% assign show_ai_chat = false %}
{% if site.ai_search_enabled? and site.settings.enable_ai_chat_search %}
  {% assign show_ai_chat = true %}
{% endif %}

<div class="relative min-h-[60vh] bg-base-100 dark:bg-base-100">
  <div
    class="mx-auto max-w-7xl bg-base-100 px-4 pb-16 pt-8 md:pt-12 dark:bg-base-100"
    data-controller="link-target{% if show_ai_chat %} search-page{% endif %}"
  >
    <div class="help-layout-with-aside{% if show_ai_chat %} is-ai-layout{% endif %}">
      <main class="help-layout-main min-w-0 bg-base-100 dark:bg-base-100">
        <header class="pt-2">
          <div class="w-full max-w-3xl">
            {% form_tag 'search', class: 'w-full', data-turbo-frame: 'frame--search-results', data-turbo-action: 'advance' %}
              <div class="relative">
                <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-base-content/50">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                  </svg>
                </span>
                <input
                  type="search"
                  autofocus
                  name="{{ form.keywords_field_name }}"
                  value="{{ search.keywords | escape_once }}"
                  placeholder="{{ search_placeholder }}"
                  autocomplete="off"
                  class="block w-full rounded-lg border-2 border-primary/40 bg-base-100 py-3 pl-10 pr-4 text-base text-base-content shadow-sm outline-none transition placeholder:text-base-content/50 focus:border-primary focus:ring-2 focus:ring-primary/25 dark:border-primary/50 dark:bg-base-300 dark:text-base-content dark:placeholder:text-base-content/60"
                >
              </div>
            {% endform_tag %}

            {% if hot_tags.size > 0 %}
              <div class="mx-auto mt-4 flex max-w-3xl flex-wrap justify-center gap-3">
                {% for hot_keyword in hot_tags %}
                  {% assign kw_trim = hot_keyword | strip %}
                  {% if kw_trim != blank %}
                    <a
                      href="{{ site.search_path }}?q={{ kw_trim | url_encode }}"
                      data-turbo-frame="frame--search-results"
                      data-turbo-action="advance"
                      class="rounded-full border border-base-300 bg-base-100 px-3 py-2 text-sm text-base-content/70 transition hover:border-primary hover:bg-primary hover:text-primary-content"
                    >
                      {{ kw_trim }}
                    </a>
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}
          </div>
        </header>

        <turbo-frame
          id="frame--search-results"
          class="mt-8 block"
          {% if show_ai_chat %}data-action="turbo:frame-load->search-page#frameLoaded"{% endif %}
        >
          {% assign frame_has_results = false %}
          {% if search.keywords or search.tag %}
            {% paginate_tag search.pages, as: 'items', per: 20 %}
              {% assign extends_size = search.extends | size %}
              {% assign items_size = items | size %}
              {% assign total_size = extends_size | plus: items_size %}
              {% assign show_extends = search.page_number == 1 %}
              {% if total_size > 0 %}
                {% assign frame_has_results = true %}
              {% endif %}

              {% if show_ai_chat %}
                <div
                  data-search-page-target="resultsMeta"
                  data-keywords="{{ search.keywords | escape_once }}"
                  data-has-results="{% if frame_has_results %}true{% else %}false{% endif %}"
                  class="hidden"
                  hidden
                  aria-hidden="true"
                ></div>
              {% endif %}

              {% if frame_has_results %}
                {% render 'support_search_list', items: items, extends: search.extends, show_extends: show_extends %}
                {% render 'support_paginate', paginate: paginate, turbo_frame: 'frame--search-results', turbo_action: 'advance' %}
              {% else %}
                <div class="py-8">
                  {% render 'empty', message: empty_message %}
                </div>
              {% endif %}
            {% endpaginate_tag %}
          {% else %}
            {% if show_ai_chat %}
              <div
                data-search-page-target="resultsMeta"
                data-keywords=""
                data-has-results="false"
                class="hidden"
                hidden
                aria-hidden="true"
              ></div>
            {% endif %}
            <div class="py-8">
              {% render 'empty', message: empty_message %}
            </div>
          {% endif %}
        </turbo-frame>
      </main>

      {% if show_ai_chat %}
        <aside class="help-layout-aside">
          {% render 'support_ai_search', keywords: search.keywords %}
        </aside>
      {% endif %}
    </div>
  </div>
</div>
