{% layout 'page_layout' %}

{% assign default_hero_image = 'images/hero-1.webp' | asset_url %}
{% assign hero_bg_image = page.settings.hero_image_url | presence | default: default_hero_image %}
{% assign hero_font_color = page.settings.hero_font_color | presence | default: '#000000' %}
{% assign hero_slogan = page.settings.hero_slogan | presence %}
{% assign hero_description = page.settings.hero_description | presence %}
{% assign featured_title = page.settings.featured_section_title | presence | default: 'templates.index_documentation.featured_title' | t %}
{% assign featured_count = page.settings.featured_count | default: 6 %}
{% assign card_pages = site.pages['/'].children_in_nav_menu | limit: featured_count %}

<main class="relative flex min-h-0 flex-1 flex-col bg-base-100">
  {% comment %} Hero band: transparent header overlays background image {% endcomment %}
  <section class="relative overflow-hidden border-b border-base-200" style="color: {{ hero_font_color }};">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <img
        src="{{ hero_bg_image }}"
        alt=""
        width="1920"
        height="640"
        decoding="async"
        class="h-full w-full object-cover object-center opacity-50"
        style="-webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 45%, transparent 100%); mask-image: linear-gradient(to bottom, #000 0%, #000 45%, transparent 100%);"
      >
      <div class="absolute inset-0 bg-gradient-to-b from-transparent via-base-100/30 to-base-100"></div>
    </div>

    <div class="relative z-10">
      {% render 'docs_home_header' %}

      <div class="px-4 pb-10 pt-2 md:px-10 md:pb-12">
        <div class="max-w-3xl">
          {% if hero_slogan | present? %}
            <h1 class="text-3xl font-bold tracking-tight md:text-4xl lg:text-5xl">
              {{ hero_slogan }}
            </h1>
          {% endif %}
          {% if hero_description | present? %}
            <p class="mt-3 max-w-2xl text-base opacity-70 md:text-lg">
              {{ hero_description }}
            </p>
          {% endif %}
        </div>
      </div>
    </div>
  </section>

  {% comment %} Featured cards {% endcomment %}
  <section class="relative z-10 px-4 py-8 md:px-10 md:py-10" aria-labelledby="docs-featured-title">
    <h2 id="docs-featured-title" class="mb-6 text-xl font-bold text-base-content md:text-2xl">
      {{ featured_title }}
    </h2>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 xl:grid-cols-3">
      {% for card_page in card_pages %}
        {% assign card_desc = card_page.settings.description | strip_html | strip %}
        {% if card_desc == blank %}
          {% assign card_desc = card_page.settings.content | strip_html | truncate: 100 %}
        {% endif %}
        <a
          href="{{ card_page.path }}"
          class="group flex flex-col overflow-hidden rounded-2xl border border-base-300 bg-base-100 no-underline shadow-sm transition-all duration-200 hover:border-primary/40 hover:shadow-md hover:no-underline focus:no-underline [&_*]:no-underline"
        >
          <div class="relative h-14 shrink-0 bg-gradient-to-br from-primary/25 to-secondary/25 sm:h-16">
            <div class="absolute -bottom-5 left-5 flex size-11 items-center justify-center rounded-xl bg-neutral text-neutral-content shadow-md ring-4 ring-base-100 transition-transform group-hover:scale-105">
              {% render 'page_nav_icon', page: card_page, class: 'size-5' %}
            </div>
          </div>
          <div class="flex flex-1 flex-col items-start px-5 pb-5 pt-8 text-left">
            <h3 class="text-base font-bold text-base-content transition-colors group-hover:text-primary line-clamp-2">
              {{ card_page.link_text }}
            </h3>
            {% if card_desc != blank %}
              <p class="mt-2 text-sm leading-relaxed text-base-content/60 line-clamp-3">
                {{ card_desc }}
              </p>
            {% endif %}
          </div>
        </a>
      {% endfor %}
    </div>
  </section>
</main>

{% schema %}
{
  "name": "Reference",
  "description": "Documentation home with sidebar nav and featured guide cards",
  "thumb_url": "images/theme/${lang}/index.documentation.png",
  "preview_image_urls": [
    "images/theme/${lang}/index.documentation.png"
  ],
  "sub_page_templates": ["page"],
  "settings": [
    {
      "id": "hero_image_url",
      "type": "image_picker",
      "ratio": "19:6",
      "width": 900,
      "label": "t:schema.templates.index.documentation.settings.hero_image_url.label",
      "info": "t:schema.templates.index.documentation.settings.hero_image_url.info"
    },
    {
      "id": "hero_font_color",
      "type": "color",
      "label": "t:schema.templates.index.documentation.settings.hero_font_color.label",
      "info": "t:schema.templates.index.documentation.settings.hero_font_color.info",
      "default": "#000000"
    },
    {
      "id": "hero_slogan",
      "type": "text",
      "label": "t:schema.templates.index.documentation.settings.hero_slogan.label",
      "default": "Developer Handbook"
    },
    {
      "id": "hero_description",
      "type": "text",
      "label": "t:schema.templates.index.documentation.settings.hero_description.label",
      "default": "Explore guides, API reference, and integration docs."
    },
    {
      "id": "search_hot_keywords",
      "type": "textarea",
      "label": "t:schema.templates.index.shared.settings.search_hot_keywords.label",
      "info": "t:schema.templates.index.shared.settings.search_hot_keywords.info",
      "default": "authentication\nAPI reference\nwebhooks"
    },
    {
      "id": "featured_section_title",
      "type": "text",
      "label": "t:schema.templates.index.documentation.settings.featured_section_title.label",
      "default": "Featured Articles"
    },
    {
      "id": "featured_count",
      "type": "number",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 6,
      "label": "t:schema.templates.index.documentation.settings.featured_count.label",
      "info": "t:schema.templates.index.documentation.settings.featured_count.info"
    }
  ]
}
{% endschema %}
