{% layout 'page_layout' %}
{% assign sub_pages = page.children_in_list %}
{% assign sub_pages_size = sub_pages | size %}

{% comment %} 页面内容部分 {% endcomment %}
<turbo-frame id="main-content" class='w-full flex-1' x-init="
               $el.addEventListener('turbo:before-fetch-request', () => {
                 $el.scrollTop = 0
                 window.scrollTo({ top: 0, behavior: 'instant' })
               })
             "
>
  {% assign right_features_block = site.settings.features_one | presence %}
  <div class='w-full group {% if right_features_block | present? %} has-right-feature-block {% endif %}'>
    <div class='w-full grid grid-cols-[1fr] gap-6 group-[.has-right-feature-block]:lg:grid-cols-[1fr_240px]'>
      <!-- 中间内容 -->
      <div class="flex flex-col px-4 lg:px-10 group-[.has-right-feature-block]:md:pr-0 py-6 overflow-x-hidden">
        <div class="pt-0 pb-6">
          {% render 'breadcrumb', breadcrumb: page.breadcrumb, page: page %}
        </div>
        {% comment %} 页面正文 {% endcomment %}
        {% render 'page_list', page: page, sub_pages: sub_pages %}
      </div>

      <!-- 右侧 feature block -->
      {% if right_features_block | present? %}
        <div class="print:hidden hidden lg:block has-right-feature-block">
          <div class="sticky top-[5.5rem] h-[calc(100vh-8rem)] max-w-full w-full overflow-auto border-l border-base-200" data-toc-target="menu">
            {{ right_features_block }}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</turbo-frame>

{% schema %}
    {
    "name": "Page Channel",
    "description": "The Page as a channel section",
    "thumb_url": "images/theme/${lang}/page.channel.png",
    "preview_image_urls": [
      "images/theme/${lang}/page.channel.png"
    ],
    "sub_page_templates": ["page"],
    "settings": [
      {
        "id": "nav_lucide_icon",
        "type": "select",
        "label": "t:schema.templates.page.settings.nav_lucide_icon.label",
        "info": "t:schema.templates.page.settings.nav_lucide_icon.info",
        "default": "folder",
        "choices_from": "$site.lucide_icons"
      },
      {
        "id": "title",
        "type": "text",
        "readonly": true,
        "label": "t:schema.templates.page.settings.title.label",
        "info": "t:schema.templates.page.settings.title.info"
      },
      {
        "id": "content",
        "type": "richtext",
        "label": "t:schema.templates.page.channel.settings.content.label",
        "readonly": true,
        "info": "t:schema.templates.page.channel.settings.content.info"
      }
    ]
    }
{% endschema %}
