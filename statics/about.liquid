<!-- Custom static page — Developers theme -->

<main class="relative px-4">
  <div class="m-auto max-w-7xl py-10 text-base-content space-y-8">
    <header class="text-center space-y-3 pb-8">
      <h1 class="text-4xl font-bold">{{ 'statics.about.title' | t }}</h1>
      <p class="text-base opacity-80">
        {{ 'statics.about.intro' | t }}
      </p>
    </header>

    <section class="space-y-4">
      <h3 class="text-2xl font-bold">{{ 'statics.about.section1_title' | t }}</h3>
      <p>
        {{ 'statics.about.section1_workspace' | t }}
        <span class="badge badge-ghost badge-secondary">{{ 'statics.about.section1_market_badge' | t }}</span>
        {{ 'statics.about.section1_find_theme' | t }}
        <span class="badge badge-ghost badge-secondary">{{ 'statics.about.section1_theme_badge' | t }}</span>
        {{ 'statics.about.section1_after_theme' | t }}
        <code class="bg-base-200 px-1 rounded">{{ 'statics.about.section1_tailwind' | t }}</code>
        {{ 'statics.about.section1_and' | t }}
        <code class="bg-base-200 px-1 rounded">{{ 'statics.about.section1_daisyui' | t }}</code>{{ 'statics.about.section1_built_in' | t }}
      </p>
      <p>
        {{ 'statics.about.section1_download_label' | t }}
        <a
          href="https://gitlab.com/baklib/themes/developers"
          target="_blank"
          class="link link-primary"
        >
          https://gitlab.com/baklib/themes/developers
        </a>
      </p>
    </section>

    <section class="space-y-4">
      <h3 class="text-2xl font-bold">{{ 'statics.about.section2_title' | t }}</h3>
      <p>
        {{ 'statics.about.section2_p1' | t }}
        <code class="bg-base-200 px-1 rounded">{{ 'statics.about.section2_statics_folder' | t }}</code>
        {{ 'statics.about.section2_p1_mid' | t }}
        <code class="bg-base-200 px-1 rounded">{{ 'statics.about.section2_templates_folder' | t }}</code>{{ 'statics.about.section2_p1_end' | t }}
      </p>

      <blockquote class="border-l-4 border-primary pl-4 italic bg-base-200 py-3 rounded">
        {{ 'statics.about.section2_quote' | t }}
        <a href="https://dev.baklib.cn" class="link link-primary" target="_blank">
          {{ 'statics.about.section2_dev_center' | t }}
        </a>
      </blockquote>
    </section>

    <section class="space-y-4">
      <h3 class="text-2xl font-bold">{{ 'statics.about.section3_title' | t }}</h3>
      <p>
        {{ 'statics.about.section3_p1' | t }}
        <code class="bg-base-200 px-1 rounded">{{ 'statics.about.section3_page_template' | t }}</code>{{ 'statics.about.section3_p1_mid' | t }}
        <code class="bg-base-200 px-1 rounded">{{ 'statics.about.section3_knowledge_base' | t }}</code>{{ 'statics.about.section3_p1_end' | t }}
      </p>
      <p>{{ 'statics.about.section3_llm' | t }}</p>
    </section>

    <div class="divider my-10"></div>

    <section class="space-y-3">
      <h2 class="text-3xl font-light">{{ 'statics.about.daisyui_title' | t }}</h2>
      <p>
        {{ 'statics.about.daisyui_body' | t }}
      </p>
    </section>

    <section class="space-y-3">
      <h2 class="text-3xl font-light">{{ 'statics.about.baklib_title' | t }}</h2>
      <p>
        {{ 'statics.about.baklib_body' | t }}
      </p>
    </section>
  </div>
</main>
