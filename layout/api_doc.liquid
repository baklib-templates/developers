<!doctype html>
<html lang="{{ site.language }}" class="scroll-smooth bg-base-100">
  <head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="author" content="Baklib">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {% meta_tags %}

    {% render 'theme_runtime_colors' %}

    {{ 'baklib/shared/main.css' | asset_url | stylesheet_tag: data-turbo-track: 'reload' }}
    {{ 'baklib/shared/main.js' | asset_url | script_tag: data-turbo-track: 'reload' }}

    {{ 'stylesheets/application.css' | asset_url | stylesheet_tag: data-turbo-track: 'reload' }}
    {{ 'javascripts/application.js' | asset_url | script_tag: defer: true, data-turbo-track: 'reload' }}


    {% comment %} <link rel="stylesheet" href="https://unpkg.com/@stoplight/elements/styles.min.css"> {% endcomment %}
    {{ 'stylesheets/elements.css' | asset_url | stylesheet_tag: data-turbo-track: 'reload' }}
    <script src="https://unpkg.com/@stoplight/elements/web-components.min.js"></script>

    {{ site.settings.head_html }}
    {% weixin_share_tag app_id: site.settings.weixin_app_id, app_secret: site.settings.weixin_app_secret, debug: site.settings.weixin_debug, enabled: site.settings.weixin_enabled %}

  </head>
  <body id="js--body" class="grid min-h-screen grid-rows-[auto_1fr_auto] bg-base-100 tracking-wide text-base-content antialiased" x-data="{ isHomePage: false, showScrollBar: false }" x-init="isHomePage = location.pathname === '{{ site.index_path }}';  window.addEventListener('scroll', () => {
          showScrollBar = window.scrollY > window.innerHeight;
        });">
    {% render 'site_header', centered: true %}
    {{ content_for_layout }}
    {% render 'footer' %}
    {% render 'scroll_bar' %}
  </body>
</html>
