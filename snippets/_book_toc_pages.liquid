{% comment %}
  Recursive book TOC (CSS-Tricks perfect TOC markup).
  @param parent_page {object}
  @param current_depth {number}
  @param max_depth {number}
  @param show_chapter_prefix {boolean}
  @param show_page_numbers {boolean}
  @param chapter_prefix {string}
  @param page_label {string} visually-hidden prefix before page number
{% endcomment %}
{% for child in parent_page.children_in_nav_menu %}
  {% assign child_nav_count = child.children_in_nav_menu | size %}
  {% assign is_level_1 = false %}
  {% if current_depth == 1 %}
    {% assign is_level_1 = true %}
  {% endif %}

  {% capture entry_title %}
    {% if is_level_1 and show_chapter_prefix %}{{ chapter_prefix }} {{ forloop.index }}. {% endif %}{{ child.link_text }}
  {% endcapture %}
  {% assign entry_title = entry_title | strip %}

  <li>
    <a href="{{ child.path }}">
      <span class="title">
        {{ entry_title }}
        {% if show_page_numbers %}
          <span class="leaders" aria-hidden="true"></span>
        {% endif %}
      </span>
      {% if show_page_numbers %}
        <span class="page" data-href="{{ child.path }}">
          <span class="visually-hidden">{{ page_label }}&nbsp;</span>
          <span class="page-num"></span>
        </span>
      {% endif %}
    </a>

    {% if current_depth < max_depth and child_nav_count > 0 %}
      <ol role="list">
        {% assign next_depth = current_depth | plus: 1 %}
        {% render 'book_toc_pages',
          parent_page: child,
          current_depth: next_depth,
          max_depth: max_depth,
          show_chapter_prefix: show_chapter_prefix,
          show_page_numbers: show_page_numbers,
          chapter_prefix: chapter_prefix,
          page_label: page_label
        %}
      </ol>
    {% endif %}
  </li>
{% endfor %}
