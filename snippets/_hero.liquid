{% comment %}
  Unified hero for documentation and portal home pages.
  @param page {object}
  @param variant {string} documentation | portal — default documentation
{% endcomment %}
{% assign _variant = variant | default: 'documentation' %}
{% assign default_hero_image = 'images/hero-1.webp' | asset_url %}
{% assign hot_tags = page.settings.hot_tags | split: ',' %}
{% assign hero_font_color = page.settings.hero_font_color | presence %}
{% assign search_placeholder = page.settings.hero_search_placeholder | presence | default: 'placeholders.search' | t %}
{% assign hero_bg_image = page.settings.hero_image_url | presence | default: default_hero_image %}

{% if _variant == 'portal' %}
  <section
    id="hero"
    aria-labelledby="portal-hero-title"
    class="text-center{% unless hero_font_color %} text-base-content{% endunless %}"
    {% if hero_font_color %}style="color: {{ hero_font_color }};"{% endif %}
  >
    {% assign hero_slogan = page.settings.hero_slogan | presence %}
    {% assign hero_description = page.settings.hero_description | presence %}
    {% if hero_slogan | present? %}
      <h1 id="portal-hero-title" class="text-3xl font-bold tracking-tight md:text-4xl lg:text-5xl">
        {{ hero_slogan }}
      </h1>
    {% endif %}
    {% if hero_description | present? %}
      <p class="mx-auto mt-4 max-w-2xl text-base md:text-lg{% if hero_font_color %} opacity-80{% else %} text-base-content/70{% endif %}">
        {{ hero_description }}
      </p>
    {% endif %}

    <div class="mx-auto mt-8 w-full max-w-xl">
      {% form_tag 'search', class: 'w-full' %}
        {% render 'search_field',
          name: form.keywords_field_name,
          value: search.keywords | escape_once,
          placeholder: search_placeholder,
          size: 'lg',
          autocomplete: 'off',
          icon: 'search',
          submit_icon: 'arrow'
        %}
      {% endform_tag %}

      {% if hot_tags | size > 0 %}
        <div class="mt-4 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-sm">
          <span class="{% if hero_font_color %}opacity-70{% else %}text-base-content/60{% endif %}">{{ 'generic.popular_search' | t }}:</span>
          {% for search_hot_key in hot_tags %}
            {% assign hot_key = search_hot_key | strip %}
            {% if hot_key != blank %}
              <a
                href="{{ site.index_path }}-/search?q={{ hot_key }}"
                class="{% if hero_font_color %}opacity-90 hover:opacity-100{% else %}text-base-content/80 hover:text-primary{% endif %} underline-offset-2 hover:underline"
              >
                {{ hot_key }}
              </a>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </section>
{% else %}
  <section id="hero" class="flex items-center justify-center flex-col bg-base-200 bg-no-repeat bg-cover bg-center h-[250px] md:h-[350px]"
    style="background-image: url({{ hero_bg_image }})"
  >
    <div class="flex items-center justify-center flex-1 w-full max-w-5xl py-3{% unless hero_font_color %} text-base-content{% endunless %}"{% if hero_font_color %} style="color: {{ hero_font_color }};"{% endif %}>
      <div class="container mx-auto flex flex-col h-full px-4">
        <div class="flex flex-col items-center justify-center flex-grow">
          {% assign hero_slogan = page.settings.hero_slogan | presence %}
          {% assign hero_description = page.settings.hero_description | presence %}
          {% if hero_slogan | present? %}
            <h1 class="py-2 mt-12 text-2xl md:text-4xl font-bold transition duration-500 md:mt-0 text-shadow">
              {{ page.settings.hero_slogan }}
            </h1>
          {% endif %}
          {% if hero_description | present? %}
            <p class="py-2 text-base transition duration-500 text-shadow{% if hero_font_color %} opacity-80{% else %} text-base-content/70{% endif %}">{{ page.settings.hero_description }}</p>
          {% endif %}

          <div class="w-full z-0 flex flex-col items-center justify-center">
            {% form_tag 'search', class: 'w-full' %}
              {% render 'search_field',
                name: form.keywords_field_name,
                value: search.keywords | escape_once,
                placeholder: 'placeholders.search' | t,
                input_type: 'text',
                size: 'lg',
                autocomplete: 'off',
                icon: 'none',
                submit_icon: 'search'
              %}
            {% endform_tag %}

            <div class="items-center justify-start hidden w-full mt-4 md:flex">
              <span class="mr-3{% if hero_font_color %} opacity-70{% else %} text-base-content/60{% endif %}">{{ 'generic.popular_search' | t }}:</span>
              {% for search_hot_key in hot_tags %}
                <a
                  href="{{site.index_path}}-/search?q={{ search_hot_key }}"
                  class="mr-3 hover:underline focus:ring{% if hero_font_color %} opacity-90 hover:opacity-100{% else %} text-base-content/80 hover:text-primary{% endif %}"
                >
                  {{ search_hot_key }}
                </a>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
{% endif %}
