{% if paginate.total_count > 0 %}
  <div class="flex items-center justify-between py-3">
    {% if paginate.total_pages > 1 %}

      <div class="flex flex-1 justify-between sm:hidden">
        <a {% if paginate.prev_page %}href="{{ paginate.url_for[paginate.prev_page] }}"{% else %}disabled{% endif %} class="relative inline-flex items-center rounded-md border border-base-300 bg-base-100 px-4 py-2 text-sm font-medium text-base-content hover:bg-base-200">{{ 'snippets.paginate.previous' | t }}</a>
        <a {% if paginate.next_page %}href="{{ paginate.url_for[paginate.next_page] }}"{% else %}disabled{% endif %} class="relative ml-3 inline-flex items-center rounded-md border border-base-300 bg-base-100 px-4 py-2 text-sm font-medium text-base-content hover:bg-base-200">{{ 'snippets.paginate.next' | t }}</a>
      </div>
      <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
        <div>
          <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm" aria-label="Pagination">
            {% comment %} Previous page {% endcomment %}
            <a {% if paginate.prev_page %}href="{{ paginate.url_for[paginate.prev_page] }}"{% else %}disabled{% endif %} class="relative inline-flex items-center rounded-l-md px-2 py-2 text-base-content/50 ring-1 ring-inset ring-base-300 hover:bg-base-200 focus:z-20 focus:outline-offset-0">
              <span class="sr-only">{{ 'snippets.paginate.previous' | t }}</span>
              <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z" clip-rule="evenodd" />
              </svg>
            </a>

            {% comment %} Page numbers {% endcomment %}
            {% for i in paginate.series %}
              {% assign type = i | typeof %}
              {% case type %}
                {% when 'string' %}
                  {% if i == 'gap' %}
                    <span class="relative inline-flex items-center px-3 py-1 text-sm font-semibold ring-1 ring-inset ring-base-300 focus:outline-offset-0">...</span>
                  {% else %}
                    <a href="#" aria-current="page" class="relative z-10 inline-flex items-center bg-primary px-3 py-1 text-sm font-semibold text-primary-content focus:z-20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">{{i}}</a>
                  {% endif %}
                {% when 'integer' %}
                  <a href="{{paginate.url_for[i]}}" class="relative inline-flex items-center px-3 py-1 text-sm font-semibold ring-1 ring-inset ring-base-300 hover:bg-base-200 focus:z-20 focus:outline-offset-0">{{i}}</a>
              {% endcase %}
            {% endfor %}

            {% comment %} Next page {% endcomment %}
            <a {% if paginate.next_page %}href="{{ paginate.url_for[paginate.next_page] }}"{% else %}disabled{% endif %} class="relative inline-flex items-center rounded-r-md px-2 py-2 text-base-content/50 ring-1 ring-inset ring-base-300 hover:bg-base-200 focus:z-20 focus:outline-offset-0">
              <span class="sr-only">{{ 'snippets.paginate.next' | t }}</span>
              <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
              </svg>
            </a>
          </nav>
        </div>
      </div>

    {% endif %}
  </div>
{% endif %}
