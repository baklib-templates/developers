{%- comment -%}
  AI search chat panel for search page aside.
  @param keywords {String} current search keywords for auto-submit (optional)
{%- endcomment -%}
{% assign ai_search_title = 'ai.title' | t: 'AI 助理' %}
{% assign ai_search_thinking_text = 'ai.thinking' | t: '正在思考…' %}
{% assign ai_search_canceled_text = 'ai.canceled' | t: '已取消' %}
{% assign ai_search_disclaimer = 'ai.disclaimer' | t: '内容由 AI 生成，可能存在错误，请自行核实。' %}
{% assign ai_widen_label = 'ai.widen' | t: '加宽对话框（占 2/3）' %}
{% assign ai_narrow_label = 'ai.narrow' | t: '收窄对话框（占 1/3）' %}
{% assign ai_collapse_label = 'ai.collapse' | t: '折叠对话框' %}
{% assign ai_expand_label = 'ai.expand' | t: '展开 AI 助手' %}
{% assign ai_input_placeholder = 'templates.search.ai_input_placeholder' | t: '继续提问…' %}
{% assign ai_search_completed_text = site.settings.ai_search_completed_text | strip | presence %}
{% unless ai_search_completed_text %}
  {% assign ai_search_completed_text = 'ai.completed' | t: '回答完毕' %}
{% endunless %}

<div
  class="hidden"
  id="js--ai-search-container"
  data-controller="ai-search-panel"
>
  <button
    type="button"
    class="ai-chat-fab btn btn-primary btn-circle btn-lg shadow-lg hidden"
    data-ai-search-panel-target="fab"
    data-action="ai-search-panel#expand"
    aria-label="{{ ai_expand_label | escape_once }}"
    title="{{ ai_expand_label | escape_once }}"
  >
    {% render 'lucide_icon', name: 'message-square', class: 'size-5' %}
  </button>

  <div
    data-ai-search-panel-target="dialog"
    class="ai-chat-dialog rounded-3xl border border-base-300 bg-base-200 shadow-lg"
  >
    <header class="flex shrink-0 items-center justify-between gap-3 border-b border-base-300 px-4 py-3">
      <div class="flex min-w-0 items-center gap-2 text-sm font-semibold text-base-content">
        <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-primary/15 text-primary">
          {% render 'lucide_icon', name: 'sparkles', class: 'size-4' %}
        </span>
        <span class="truncate">{{ ai_search_title }}</span>
      </div>

      <div class="flex shrink-0 items-center gap-1">
        <button
          type="button"
          class="ai-chat-width-toggle btn btn-ghost btn-sm btn-square text-base-content/70"
          data-ai-search-panel-target="widthButton"
          data-action="ai-search-panel#toggleWidth"
          data-ai-search-panel-widen-label-param="{{ ai_widen_label | escape_once }}"
          data-ai-search-panel-narrow-label-param="{{ ai_narrow_label | escape_once }}"
          aria-label="{{ ai_widen_label | escape_once }}"
          title="{{ ai_widen_label | escape_once }}"
        >
          <span data-ai-search-panel-target="widenIcon">
            {% render 'lucide_icon', name: 'maximize-2', class: 'size-4' %}
          </span>
          <span data-ai-search-panel-target="narrowIcon" class="hidden">
            {% render 'lucide_icon', name: 'minimize-2', class: 'size-4' %}
          </span>
        </button>
        <button
          type="button"
          class="btn btn-ghost btn-sm btn-square text-base-content/70"
          data-action="ai-search-panel#collapse"
          aria-label="{{ ai_collapse_label | escape_once }}"
          title="{{ ai_collapse_label | escape_once }}"
        >
          {% render 'lucide_icon', name: 'x', class: 'size-4' %}
        </button>
      </div>
    </header>

    <div
      id="js--ai-search"
      class="flex min-h-0 flex-1 flex-col"
      data-controller="ai-search"
      data-ai-search-hidden-class="hidden opacity-0"
      data-ai-search-messages-value='{"thinking":"{{ ai_search_thinking_text | escape_once }}","completed":"{{ ai_search_completed_text | escape_once }}","canceled":"{{ ai_search_canceled_text | escape_once }}"}'
      data-ai-search-url-value="/-/ai-search-completion"
      data-ai-search-auto-submit-value="true"
      {% if keywords != blank %}
        data-ai-search-message-value="{{ keywords | escape_once }}"
      {% endif %}
    >
      <div class="relative min-h-0 flex-1">
        <div
          data-ai-search-target="messages"
          class="ai-chat-messages ai-response prose absolute inset-0 overflow-y-auto px-4 py-4 prose-sm dark:prose-invert"
        ></div>
        <p class="ai-chat-empty-hint pointer-events-none absolute inset-0 flex items-center justify-center px-6 text-center text-sm leading-6 text-base-content/50">
          {{ ai_search_disclaimer }}
        </p>
      </div>

      <template data-ai-search-target="userMessageTemplate">
        <div class="chat chat-end mb-3">
          <div class="chat-image avatar">
            <div class="flex size-8 items-center justify-center rounded-full bg-primary text-primary-content">
              <svg width="20" height="20" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <circle cx="14" cy="11" r="5" fill="currentColor"/>
                <ellipse cx="14" cy="21" rx="7" ry="4" fill="currentColor"/>
              </svg>
            </div>
          </div>
          <div class="chat-bubble chat-bubble-primary max-w-[92%] break-words text-sm">
            <span class="ai-user-message"></span>
          </div>
        </div>
      </template>

      <template data-ai-search-target="assistantMessageTemplate">
        <div class="chat chat-start mb-3">
          <div class="chat-image avatar">
            <div class="flex size-8 items-center justify-center rounded-full bg-secondary text-secondary-content">
              <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/>
                <path d="M20 3v4"/>
                <path d="M22 5h-4"/>
                <path d="M4 17v2"/>
                <path d="M5 18H3"/>
              </svg>
            </div>
          </div>
          <div class="chat-bubble max-w-[92%] break-words bg-base-100 text-sm text-base-content shadow-sm">
            <span class="ai-assistant-message"></span>
          </div>
        </div>
      </template>

      <div class="shrink-0 border-t border-base-300 p-3">
        <div class="flex items-center gap-2 rounded-2xl border border-base-300 bg-base-100 px-3 py-2 shadow-sm">
          <input
            type="text"
            class="input input-ghost h-9 min-w-0 flex-1 border-0 bg-transparent px-0 text-sm focus:outline-none"
            placeholder="{{ ai_input_placeholder | escape_once }}"
            id="js--ai-chat-input"
            data-ai-search-target="input"
            autocomplete="off"
          >
          <button
            class="btn btn-primary btn-circle btn-sm"
            id="js--ai-chat-send"
            data-ai-search-target="send"
            type="button"
            aria-label="{{ ai_input_placeholder | escape_once }}"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M13 7.828V20h-2V7.828l-5.364 5.364-1.414-1.414L12 4l7.778 7.778-1.414 1.414L13 7.828z"></path>
            </svg>
          </button>
        </div>
        <div data-ai-search-target="error" class="mt-2 hidden text-sm text-error opacity-100 transition-opacity duration-300"></div>
      </div>
    </div>
  </div>
</div>
