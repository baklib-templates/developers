<header
  class="js--header sticky top-0 z-50 flex min-h-16 w-full flex-col justify-center border-b border-base-300 bg-base-100/95 px-4 text-base-content backdrop-blur transition-shadow duration-100 print:hidden shadow-sm supports-[backdrop-filter]:bg-base-100/80 md:px-10 [transform:translate3d(0,0,0)]"
>
  <nav class="navbar flex w-full px-0 py-0">
    <div class="flex w-full min-w-0 items-center gap-2 lg:gap-4">
      <div class="block flex-1 md:hidden">
        {% render 'header_logo' title_style: 'font-bold text-xl md:text-2xl text-base-content/80' %}
      </div>
      <div class="hidden min-w-0 flex-1 md:flex">
        {% assign header_menu_html = site.settings.header_menu_html | presence %}
        {% if header_menu_html %}
          <div class="flex items-center gap-6 [&_a]:text-sm [&_a]:font-medium [&_a]:text-base-content/70 [&_a]:transition-colors [&_a]:hover:text-primary">{{ header_menu_html }}</div>
        {% else %}
          <div class="flex items-center gap-6">
            <ul class="menu menu-horizontal pl-0">
              <li><a class="flex items-center space-x-1 hover:text-primary hover:underline" href="{{ statics['about'] }}">{{ 'generic.about' | t }}</a></li>
            </ul>
          </div>
        {% endif %}
      </div>

      <div class="grow max-w-[12em] min-w-[6em]">
        {% render 'search_trigger' %}
      </div>

      <div class="md:hidden">
        {% render 'header_drawer' %}
      </div>
    </div>
  </nav>
</header>
