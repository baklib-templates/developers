{% comment %}
  Sidebar footer: sign in / register or signed-in account menu.
  Reference: cms/resources/snippets/_header.liquid (user center block)
{% endcomment %}
{% assign can_baklib_login = site.baklib_login_enabled %}
{% assign can_sso_login = site.sso_login_enabled %}

{% if current_user %}
  <div class="dropdown dropdown-top w-full">
    <button
      type="button"
      tabindex="0"
      class="flex w-full min-w-0 items-center gap-3 rounded-lg px-2 py-2 text-left transition-colors hover:bg-base-300/60"
      aria-label="{{ 'snippets.sidebar_user_account.user_center' | t: '个人中心' | escape_once }}"
    >
      {% if current_user.image %}
        <img
          src="{{ current_user.image | asset_url }}"
          alt="{{ current_user.name | escape_once }}"
          class="size-8 shrink-0 rounded-full object-cover"
          width="32"
          height="32"
        >
      {% else %}
        <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-primary/15 text-primary">
          {% render 'lucide_icon', name: 'user', class: 'size-4' %}
        </span>
      {% endif %}
      <span class="min-w-0 flex-1 truncate text-sm font-medium text-base-content">{{ current_user.name }}</span>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4 shrink-0 text-base-content/45" aria-hidden="true">
        <path fill-rule="evenodd" d="M11.47 7.47a.75.75 0 0 1 1.06 0l7.5 7.5a.75.75 0 1 1-1.06 1.06L12 9.06l-6.97 6.97a.75.75 0 0 1-1.06-1.06l7.5-7.5Z" clip-rule="evenodd" />
      </svg>
    </button>
    <ul
      tabindex="0"
      class="dropdown-content menu z-50 mb-2 w-full min-w-48 rounded-box border border-base-300 bg-base-100 p-2 shadow-lg"
    >
      <li>
        <a href="{{ current_user.profile_url }}" class="text-sm">
          {% render 'lucide_icon', name: 'user', class: 'size-4' %}
          {{ 'snippets.sidebar_user_account.profile' | t: '个人信息' }}
        </a>
      </li>
      <li>
        {% form_tag 'sign_out' %}
          <button
            type="submit"
            class="flex w-full items-center gap-2 text-left text-sm text-error"
            data-disable-with='{{ "snippets.sidebar_user_account.signout_loading" | t: "退出中..." }}'
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4 shrink-0" aria-hidden="true">
              <path fill-rule="evenodd" d="M7.5 3.75A1.5 1.5 0 0 0 6 5.25v13.5a1.5 1.5 0 0 0 1.5 1.5h6a1.5 1.5 0 0 0 1.5-1.5V15a.75.75 0 0 1 1.5 0v3.75a3 3 0 0 1-3 3h-6a3 3 0 0 1-3-3V5.25a3 3 0 0 1 3-3h6a3 3 0 0 1 3 3V9A.75.75 0 0 1 15 9V5.25a1.5 1.5 0 0 0-1.5-1.5h-6Zm5.03 4.72a.75.75 0 0 1 0 1.06l-1.72 1.72h10.94a.75.75 0 0 1 0 1.5H10.75l1.72 1.72a.75.75 0 1 1-1.06 1.06l-3-3a.75.75 0 0 1 0-1.06l3-3a.75.75 0 0 1 1.06 0Z" clip-rule="evenodd" />
            </svg>
            {{ 'snippets.sidebar_user_account.signout' | t: '退出登录' }}
          </button>
        {% endform_tag %}
      </li>
    </ul>
  </div>
{% elsif can_baklib_login %}
  <div class="flex items-center justify-between gap-2">
    {% form_tag 'sign_in_with_baklib', class: 'min-w-0' %}
      <input type="hidden" name="sign_up" value="true">
      <button
        type="submit"
        class="btn btn-ghost btn-sm h-9 min-h-9 px-2 font-normal text-base-content/70 hover:text-primary"
        data-disable-with='{{ "snippets.sidebar_user_account.signin_loading" | t: "登录中..." }}'
      >
        {{ 'snippets.sidebar_user_account.create_account' | t: '创建账户' }}
      </button>
    {% endform_tag %}
    {% form_tag 'sign_in_with_baklib', class: 'shrink-0' %}
      <button
        type="submit"
        class="btn btn-outline btn-sm h-9 min-h-9 border-base-content/20 px-4 font-normal text-base-content/80 hover:border-base-content/35 hover:bg-base-300/50"
        data-disable-with='{{ "snippets.sidebar_user_account.signin_loading" | t: "登录中..." }}'
      >
        {{ 'snippets.sidebar_user_account.signin' | t: '登录' }}
      </button>
    {% endform_tag %}
  </div>
{% elsif can_sso_login %}
  {% form_tag 'sign_in_with_sso', class: 'w-full' %}
    <button
      type="submit"
      class="btn btn-outline btn-sm h-9 min-h-9 w-full border-base-content/20 font-normal text-base-content/80 hover:border-base-content/35 hover:bg-base-300/50"
      data-disable-with='{{ "snippets.sidebar_user_account.signin_loading" | t: "登录中..." }}'
    >
      {{ 'snippets.sidebar_user_account.signin' | t: '登录' }}
    </button>
  {% endform_tag %}
{% endif %}
