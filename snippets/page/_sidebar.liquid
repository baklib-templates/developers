<div class='hidden md:block'>
  <div class="sticky top-0 z-20 h-screen md:border-r md:border-base-300">
    <aside class="flex h-full w-full flex-col bg-base-200 px-4">
      <div class="flex-none space-y-3 pb-2 pt-4">
        <div class="items-center gap-2 lg:flex">
          {% render 'header_logo' title_style: 'font-bold md:text-xl text-base-content/80 whitespace-nowrap' %}
        </div>
        <div class="pb-2">
          {% render 'search_trigger' %}
        </div>
      </div>
      <ul
        class="custom-menu min-h-0 w-full flex-1 overflow-y-auto px-0 py-0"
        data-controller="navtree"
        data-navtree-target="menuList"
      >
        <turbo-frame id="page_nav_tree_frame__" src="/s/page/nav_tree" loading="lazy">
          <div class="flex h-20 items-center justify-center text-base-content/60">
            <span class="loading loading-spinner loading-md"></span>
          </div>
        </turbo-frame>
      </ul>
      <div class="flex-none -mx-4 border-t border-base-300 bg-base-300 px-4 py-3">
        {% render 'page/sidebar_user_account' %}
      </div>
    </aside>
  </div>
</div>
