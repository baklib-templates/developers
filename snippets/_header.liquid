<header
  class="js--header sticky top-0 z-50 flex min-h-16 w-full flex-col justify-center border-b border-base-300 bg-base-100/95 px-4 text-base-content backdrop-blur transition-shadow duration-100 print:hidden shadow-sm"
>
  <nav class="navbar mx-auto max-w-6xl flex w-full px-0 py-0">
    <div class="flex w-full min-w-0 items-center justify-between gap-2 lg:gap-4">
      {% render 'header_logo' title_style: 'font-bold text-xl md:text-2xl text-base-content/80' %}
      {% assign header_menu_html = site.settings.header_menu_html | presence %}
      {% if header_menu_html %}
        <div class="hidden h-10 w-px bg-base-300 md:block"></div>
        <div class="hidden min-w-0 flex-1 md:flex">
          <div class="flex items-center gap-6 [&_a]:text-sm [&_a]:font-medium [&_a]:text-base-content/70 [&_a]:transition-colors [&_a]:hover:text-primary">{{ header_menu_html }}</div>
        </div>
      {% endif %}

      <div class="flex md:hidden">
        {% render 'header_drawer' %}
      </div>
    </div>
  </nav>
</header>
