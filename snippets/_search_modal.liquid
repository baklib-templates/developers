{% assign home_page = site.pages['/'] %}
{% assign hot_tags = home_page.settings.hot_tags | split: ',' %}
{% assign hot_pages = site.pages['/'].children | order_by: '-views_count' | limit: 5 %}

{%- comment -%} 挂在 body 末尾，fixed 相对视口；z-index 需高于 header(z-50) 与 drawer(z-999) {%- endcomment -%}
<div id="site-search-modal-root">
<!-- Modal backdrop -->
<div
  data-search-modal-layer
  class="fixed inset-0 bg-neutral/30 backdrop-blur-sm transition-opacity"
  x-show="$store.search.open"
  x-transition:enter="transition ease-out duration-200"
  x-transition:enter-start="opacity-0"
  x-transition:enter-end="opacity-100"
  x-transition:leave="transition ease-out duration-100"
  x-transition:leave-start="opacity-100"
  x-transition:leave-end="opacity-0"
  aria-hidden="true"
  x-cloak
  @click="$store.search.closeSearch()"
></div>
<!-- Modal dialog -->
<div
  id="search-modal"
  data-search-modal-layer
  class="fixed inset-0 flex items-start justify-center overflow-y-auto px-4 py-[10vh] sm:px-6"
  role="dialog"
  aria-modal="true"
  x-cloak
  x-show="$store.search.open"
  x-transition:enter="transition ease-in-out duration-200"
  x-transition:enter-start="opacity-0 translate-y-4"
  x-transition:enter-end="opacity-100 translate-y-0"
  x-transition:leave="transition ease-in-out duration-200"
  x-transition:leave-start="opacity-100 translate-y-0"
  x-transition:leave-end="opacity-0 translate-y-4"
>
  <div
    class="w-full max-w-2xl max-h-[min(80vh,calc(100vh-5rem))] overflow-auto rounded-lg bg-base-200 p-4 shadow-lg lg:p-8"
    @click.outside="$store.search.closeSearch()"
    @keydown.escape.window="$store.search.closeSearch()"
  >
    {% form_tag 'search' %}
      <label for="modal-search" class="sr-only">{{ 'accessibility.search' | t }}</label>
      {% render 'search_field',
        id: 'modal-search',
        name: form.keywords_field_name,
        value: search.keywords | escape_once,
        placeholder: 'placeholders.search' | t,
        icon: 'search'
      %}
    {% endform_tag %}
    <div class="space-y-4 px-2 py-4">
      <div>
        <div class="mb-2 px-2 text-sm font-medium text-base-content/60">{{ 'generic.hot_pages' | t }}:</div>
        <ul class="list-inside list-disc">
          {% for hot_page in hot_pages %}
            <li class="rounded px-2 py-1 text-sm leading-6 outline-none">
              <a href="{{ hot_page.path }}">
                <span>{{ hot_page.link_text }}</span>
              </a>
            </li>
          {% endfor %}
        </ul>
      </div>
      <div>
        <div class="mb-2 px-2 text-sm font-medium text-base-content/60">{{ 'generic.popular_search' | t }}:</div>
        <div class="mb-2 gap-4 px-2">
          {% for search_hot_key in hot_tags %}
            <a
              href="{{ site.index_path }}-/search?q={{ search_hot_key }}"
              class="badge badge-outline text-sm hover:bg-primary hover:text-primary-content"
            >
              {{ search_hot_key }}
            </a>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>
</div>
